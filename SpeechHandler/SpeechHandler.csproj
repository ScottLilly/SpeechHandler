<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon />
  </PropertyGroup>

  <!-- Vosk native binaries (x64). The package targets also copy these; this keeps output self-contained. -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)vosk\0.3.38\build\lib\win-x64\*.dll" Condition="Exists('$(NuGetPackageRoot)vosk\0.3.38\build\lib\win-x64')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

</Project>
