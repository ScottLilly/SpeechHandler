<Window x:Class="SpeechHandler.AboutWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Speech Handler"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBg}"
        Foreground="{StaticResource TextPrimary}"
        TextElement.Foreground="{StaticResource TextPrimary}">
    <DockPanel Margin="24">
        <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="OK"
                HorizontalAlignment="Right" MinWidth="90" IsDefault="True" IsCancel="True"
                Click="Ok_Click"/>
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Speech Handler"/>
            <TextBlock x:Name="VersionText" Margin="0,8,0,0" FontSize="14"/>
            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                       Text="Transcribe live audio and files with a local Vosk model or a cloud speech API, then play the transcript with a Kokoro or Piper neural voice."/>
        </StackPanel>
    </DockPanel>
</Window>
