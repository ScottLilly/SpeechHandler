<Window x:Class="SpeechHandler.TtsSettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice settings"
        Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBg}"
        Foreground="{StaticResource TextPrimary}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        Closed="Window_Closed">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}" Content="Close"
                    Width="120" IsDefault="True" Click="Close_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Speech voices"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Kokoro is a small open-source neural model that sounds more natural than Piper. One download unlocks all Kokoro English voices. Piper voices are smaller and stay available as a lighter option."/>

            <Label Content="Engine" Padding="0,0,0,6" HorizontalAlignment="Left"/>
            <ComboBox x:Name="EngineCombo" Width="280" HorizontalAlignment="Left"
                      SelectionChanged="EngineCombo_SelectionChanged"/>

            <Label Content="Voice" Padding="0,12,0,6" HorizontalAlignment="Left"/>
            <ComboBox x:Name="VoiceCombo" SelectionChanged="VoiceCombo_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Label Content="Speaking speed" Padding="0,12,0,6" HorizontalAlignment="Left"/>
            <ComboBox x:Name="SpeedCombo" Width="200" HorizontalAlignment="Left"/>

            <TextBlock Style="{StaticResource SectionTitle}" Margin="0,20,0,0" Text="Voice packs"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Download packs to your computer. Kokoro is recommended. Piper high is a smaller fallback."/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PackCombo" Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                                               Text="{Binding SizeLabel}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Foreground="#3DDC97" FontWeight="SemiBold" Text="Downloaded">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="DownloadButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                        Content="Download" Width="120" Click="DownloadPack_Click"/>
            </Grid>

            <Button x:Name="DownloadRecommendedButton" Style="{StaticResource PrimaryButton}"
                    Content="Download recommended voices" Margin="0,12,0,0" HorizontalAlignment="Left"
                    Click="DownloadRecommended_Click"/>

            <TextBlock x:Name="VoicesFolderText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Margin="0,12,0,0"/>

            <StackPanel x:Name="DownloadProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="DownloadMessage" Text="Downloading…" Margin="0,0,0,8"/>
                <ProgressBar x:Name="DownloadBar" IsIndeterminate="True"/>
                <Button x:Name="CancelDownloadButton" Style="{StaticResource SecondaryButton}"
                        Content="Cancel download" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Click="CancelDownload_Click"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
