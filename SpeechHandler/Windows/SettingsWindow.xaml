<Window x:Class="SpeechHandler.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcription settings"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBg}"
        Foreground="{StaticResource TextPrimary}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        Closed="Window_Closed">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}" Content="Close"
                    Width="120" IsDefault="True" Click="Close_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Speech engine"/>
            <ComboBox x:Name="EngineCombo" Width="280" HorizontalAlignment="Left"
                      SelectionChanged="EngineCombo_SelectionChanged">
                <ComboBoxItem Content="Local (Vosk)" IsSelected="True"/>
                <ComboBoxItem Content="OpenAI Whisper API"/>
                <ComboBoxItem Content="ElevenLabs"/>
            </ComboBox>

            <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,0" Text="Vosk memory cache"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Recently used local models stay in RAM so you can switch without reloading. Set a limit so they cannot fill the computer."/>
            <TextBlock x:Name="PhysicalRamText" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="SuggestedRamText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <Label Content="Cache limit" Padding="0,0,0,6" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CacheBudgetMinus" Style="{StaticResource SecondaryButton}"
                        Content="−" MinWidth="36" Padding="0,6" Width="36"
                        Click="CacheBudgetMinus_Click"/>
                <TextBox x:Name="CacheBudgetBox" Width="72" Margin="6,0"
                         TextAlignment="Center" MaxLength="3"
                         VerticalContentAlignment="Center"
                         PreviewTextInput="CacheBudgetBox_PreviewTextInput"
                         PreviewKeyDown="CacheBudgetBox_PreviewKeyDown"
                         LostFocus="CacheBudgetBox_LostFocus"/>
                <Button x:Name="CacheBudgetPlus" Style="{StaticResource SecondaryButton}"
                        Content="+" MinWidth="36" Padding="0,6" Width="36"
                        Click="CacheBudgetPlus_Click"/>
                <TextBlock Text="GB" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="CacheBudgetHint" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <StackPanel x:Name="LocalSettingsPanel" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Vosk model"/>
                <Label Content="Language" Padding="0,0,0,6" HorizontalAlignment="Left"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="VoskLanguageCombo" Margin="0,0,8,0"
                              SelectionChanged="VoskLanguageCombo_SelectionChanged"/>
                </Grid>
                <Label Content="Model file" Padding="0,12,0,6" HorizontalAlignment="Left"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="VoskModelCombo" Margin="0,0,8,0"
                              SelectionChanged="VoskModelCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                               Foreground="#3DDC97" FontWeight="SemiBold" Text="Downloaded">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="DownloadButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="Download" Width="120" Click="DownloadModel_Click"/>
                </Grid>
                <Label Content="Models folder" Padding="0,12,0,6" HorizontalAlignment="Left"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource FieldBg}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,8,0">
                        <TextBlock x:Name="ModelPathText" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Text="No folder selected"/>
                    </Border>
                    <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="Browse…" Width="120" Click="BrowseModel_Click"/>
                </Grid>
                <StackPanel x:Name="DownloadProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="DownloadMessage" Text="Downloading…" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="DownloadBar" IsIndeterminate="True"/>
                    <Button x:Name="CancelDownloadButton" Style="{StaticResource SecondaryButton}"
                            Content="Cancel download" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Click="CancelDownload_Click"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ElevenLabsSettingsPanel" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionTitle}" Text="ElevenLabs"/>
                <Label Content="Model" Padding="0,0,0,6" HorizontalAlignment="Left"/>
                <ComboBox x:Name="ElevenLabsModelCombo" Width="240" HorizontalAlignment="Left">
                    <ComboBoxItem Content="scribe_v2" IsSelected="True"/>
                    <ComboBoxItem Content="scribe_v1"/>
                </ComboBox>
                <Label Content="API key" Padding="0,12,0,6" HorizontalAlignment="Left"/>
                <PasswordBox x:Name="ElevenLabsApiKeyBox"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="The key is not saved. ELEVENLABS_API_KEY is used automatically if present."/>
            </StackPanel>

            <StackPanel x:Name="ApiSettingsPanel" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionTitle}" Text="OpenAI Whisper"/>
                <Label Content="Model" Padding="0,0,0,6" HorizontalAlignment="Left"/>
                <ComboBox x:Name="WhisperModelCombo" Width="240" HorizontalAlignment="Left">
                    <ComboBoxItem Content="whisper-1" IsSelected="True"/>
                    <ComboBoxItem Content="gpt-4o-mini-transcribe"/>
                    <ComboBoxItem Content="gpt-4o-transcribe"/>
                </ComboBox>
                <Label Content="API key" Padding="0,12,0,6" HorizontalAlignment="Left"/>
                <PasswordBox x:Name="ApiKeyBox"/>
                <CheckBox x:Name="TranslateCheck" Margin="0,12,0,0"
                          Content="Translate speech to English (Whisper translations endpoint)"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="The key is not saved. OPENAI_API_KEY is used automatically if present."/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
