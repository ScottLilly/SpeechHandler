<Window x:Class="SpeechHandler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speech Handler"
        Height="1040" Width="1240"
        MinHeight="900" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}"
        Foreground="{StaticResource TextPrimary}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        Closed="Window_Closed" Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem x:Name="SettingsMenuItem" Header="_Transcription settings…" Click="Settings_Click"/>
                <MenuItem x:Name="TtsSettingsMenuItem" Header="_Voice settings…" Click="TtsSettings_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Speech Handler…" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Border x:Name="ProcessingOverlay" DockPanel.Dock="Top" Background="#252B33"
                BorderBrush="#3D9CF0" BorderThickness="0,0,0,2" Padding="20,14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ProcessingMessage" Text="Processing…" FontSize="16" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="ProcessingBar" Margin="0,10,0,0" IsIndeterminate="True"/>
                </StackPanel>
                <Button x:Name="CancelProcessingButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                        Content="Cancel" Margin="16,0,0,0" VerticalAlignment="Center"
                        Click="CancelProcessing_Click"/>
            </Grid>
        </Border>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="420"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="SourceColumn" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="560"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="Language" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Margin="0,0,0,8"
                              VerticalAlignment="Center" HorizontalAlignment="Stretch"
                              SelectionChanged="LanguageCombo_SelectionChanged"/>
                    <TextBlock Grid.Row="1" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="Model/Service" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <ComboBox x:Name="InstalledModelCombo" Grid.Row="1" Grid.Column="1"
                              VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                              SelectionChanged="InstalledModelCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                               Foreground="#3DDC97" FontWeight="SemiBold" Text="In memory">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InMemory}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TabControl x:Name="SourceTabs" Grid.Row="2" Grid.ColumnSpan="2"
                                Style="{StaticResource SourceTabControl}"
                                ItemContainerStyle="{StaticResource SourceTabItem}"
                                SelectionChanged="SourceTabs_SelectionChanged">
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="Audio file" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </TabItem.Header>
                            <Grid MinHeight="144">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="FilePlaceholder" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="No file selected."/>
                                <Grid x:Name="FileDetailsPanel" Visibility="Collapsed" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource MutedText}" Text="Name"/>
                                    <TextBlock x:Name="SelectedFileName" Grid.Column="1" Margin="12,0,0,6"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Text="Length"/>
                                    <TextBlock x:Name="SelectedFileDuration" Grid.Row="1" Grid.Column="1"
                                               Margin="12,0,0,6" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" Text="Size"/>
                                    <TextBlock x:Name="SelectedFileSize" Grid.Row="2" Grid.Column="1"
                                               Margin="12,0,0,6" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="3" Style="{StaticResource MutedText}" Text="Format"/>
                                    <TextBlock x:Name="SelectedFileFormat" Grid.Row="3" Grid.Column="1"
                                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ChooseFileButton" Style="{StaticResource SecondaryButton}"
                                            Content="Choose file…" HorizontalAlignment="Stretch"
                                            Click="ChooseFile_Click"/>
                                    <Button x:Name="TranscribeFileButton" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                            Content="Transcribe" HorizontalAlignment="Stretch"
                                            IsEnabled="False" Click="TranscribeFile_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="Live transcription" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </TabItem.Header>
                            <Grid MinHeight="144">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Input source" Style="{StaticResource MutedText}"/>
                                <DockPanel Grid.Row="1" Margin="0,6,0,0" LastChildFill="True">
                                    <Button x:Name="RefreshSourcesButton" DockPanel.Dock="Right"
                                            Style="{StaticResource SecondaryButton}" Content="Refresh"
                                            MinWidth="80" Padding="10,4" Margin="8,0,0,0"
                                            Click="RefreshSources_Click"/>
                                    <ComboBox x:Name="SourcesCombo" DisplayMemberPath="DisplayName"
                                              HorizontalAlignment="Stretch" Margin="0" Padding="0,6,8,6"
                                              SelectionChanged="SourcesCombo_SelectionChanged"/>
                                </DockPanel>
                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Input level" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="InputLevelBar" Grid.Column="1" Margin="12,0,0,0"
                                                 Minimum="0" Maximum="1" Value="0" Height="16"
                                                 VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="StartLiveButton" Style="{StaticResource PrimaryButton}"
                                            Content="Start" HorizontalAlignment="Stretch"
                                            Click="StartLive_Click"/>
                                    <Button x:Name="StopLiveButton" Grid.Column="2" Style="{StaticResource DangerButton}"
                                            Content="Stop" HorizontalAlignment="Stretch"
                                            IsEnabled="False" Click="StopLive_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Border x:Name="CachePanel" Grid.Column="1"
                        Style="{StaticResource Card}" Padding="12,10" Margin="20,0,0,0"
                        VerticalAlignment="Top"
                        Height="{Binding ActualHeight, ElementName=SourceColumn}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CacheSummaryText"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Text="No models loaded"/>
                        <Border x:Name="CacheBarHost" Grid.Row="1"
                                Height="32"
                                Margin="0,8,0,0"
                                Background="#1A222B"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                ClipToBounds="True"
                                ToolTip="Memory reserved for loaded Vosk models">
                            <Grid x:Name="CacheBarGrid"/>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock x:Name="LoadedModelsEmpty"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       Text="No Vosk models are in memory yet. After you transcribe, they stay loaded so you can switch without waiting."/>
                            <ScrollViewer x:Name="LoadedModelsScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Style.Triggers>
                                            <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                                                <Setter Property="Padding" Value="0,0,12,0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl x:Name="LoadedModelsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource CardBorder}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                                            <Run Text="{Binding MemoryText, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding LastUsedText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Content="Unload"
                                                            MinWidth="80"
                                                            Padding="10,4"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding ModelPath}"
                                                            IsEnabled="{Binding CanUnload}"
                                                            Click="UnloadModel_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#6B7682" Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock x:Name="PartialText" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}"
                               FontStyle="Italic" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TabControl x:Name="TranscriptViewTabs" Style="{StaticResource ContentTabControl}"
                                ItemContainerStyle="{StaticResource ContentTabItem}">
                        <TabItem Header="Transcript">
                            <AdornerDecorator>
                                <TextBox x:Name="TranscriptBox"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Stretch"
                                         HorizontalAlignment="Stretch"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         FontSize="15"
                                         SpellCheck.IsEnabled="True"
                                         Language="en-US"/>
                            </AdornerDecorator>
                        </TabItem>
                        <TabItem Header="Subtitles (SRT)">
                            <AdornerDecorator>
                                <TextBox x:Name="SrtBox"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalAlignment="Stretch"
                                         HorizontalAlignment="Stretch"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontSize="14"
                                         FontFamily="Consolas"
                                         SpellCheck.IsEnabled="True"
                                         Language="en-US"/>
                            </AdornerDecorator>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox x:Name="TtsVoiceCombo" Width="320" VerticalAlignment="Center"
                                  SelectionChanged="TtsVoiceCombo_SelectionChanged"/>
                        <Button x:Name="SpeakButton" Style="{StaticResource PrimaryButton}" Content="Speak transcript"
                                Margin="8,0,0,0" MinWidth="150" Click="Speak_Click"/>
                        <Button x:Name="SaveAudioButton" Style="{StaticResource SecondaryButton}" Content="Save audio…"
                                Margin="8,0,0,0" MinWidth="130" Click="SaveAudio_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="Copy" MinWidth="90" Click="Copy_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Save as…" MinWidth="90" Margin="8,0,0,0" Click="Save_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Clear" MinWidth="90" Margin="8,0,0,0" Click="Clear_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
